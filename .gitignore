# Preserve older local builds without publishing outdated game entrypoints.
dist/*
!dist/index.html
!dist/一局江湖.html
!dist/一局江湖-v0.17.0.html
!dist/一局江湖-v0.18.0.html

# Editable full-size card artwork stays local; publish lightweight runtime WebP only.
assets/cards/originals/
# Superseded generated portrait PNGs; full-size sources remain available.
assets/enemies/runtime/*.png
assets/players/runtime/*.png

# Keep the full-size generated battle paintings local; ship compressed WebP only.
assets/battles/originals/

# Keep full-size journey scene paintings local.
assets/journey/originals/

# Full-size expansion portraits stay local; publish their runtime WebP.
assets/enemies/qingchengguard.png
assets/enemies/shenlong.png
